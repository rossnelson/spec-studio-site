#!/bin/sh
# demo-areas: the demo data of the areas and projects stills, in its own support
# folder ($TRY/support-areas), never in your own. It makes:
#   - two more demo repos next to the notes demo, local git repos with no remote:
#     /Users/Shared/spec-studio-demo/notes-web and notes-sync, each with demo specs;
#   - repos.json with the three repos;
#   - areas.json with three areas: "Notes app", "Website" and "Sync";
#   - the demo project "Shared lists", with two milestones and a spec that waits
#     for another spec, made with `studio project`.
# Run it again to start from the same data. It prints the project's ID, for
# `./launch <theme> "$TRY/support-areas" - -selectedSpec project:<id>`.
set -e
TRY="$HOME/Library/Caches/Spec Studio/try/marketing"
SUPPORT="$TRY/support-areas"
DEMO=/Users/Shared/spec-studio-demo
NOTES=$DEMO/notes WEB=$DEMO/notes-web SYNC=$DEMO/notes-sync
st() { SPEC_STUDIO_SUPPORT="$SUPPORT" "$TRY/Spec Studio.app/Contents/Helpers/studio" "$@"; }

rm -rf "$SUPPORT" "$WEB" "$SYNC"
mkdir -p "$SUPPORT"
for repo in "$WEB" "$SYNC"; do
  mkdir -p "$repo/specs"
  printf '# %s\n\nA demo repo of the notes app.\n' "$(basename "$repo")" > "$repo/README.md"
  printf '*/state.json\n*/activity.jsonl\n*/reviews/\n*/loop/\n*/.lock\n' > "$repo/specs/.gitignore"
  git -C "$repo" init -q -b main
  git -C "$repo" add -A
  git -C "$repo" -c user.name=Demo -c user.email=demo@example.com commit -qm "First commit"
done
printf '[\n  {"path": "%s"},\n  {"path": "%s"},\n  {"path": "%s"}\n]\n' "$NOTES" "$WEB" "$SYNC" > "$SUPPORT/repos.json"

# spec <repo> <slug> <title> <stage> <status>: a demo spec at a stage, with its status.
spec() {
  printf 'A demo spec.\n\n## Scope\n\n### In scope\n- %s\n\n## Requirements\n\n### R1 %s\nThe notes app does it.\n\n#### R1.S1 It works\n- Given a list\n- When the user asks\n- Then the app does it\n' "$3" "$3" |
    st new "$3" --home "$1" --slug "$2" --mode guided --description - >/dev/null
  [ "$4" = spec ] || printf '# Plan: %s\n\n## Approach\nA demo plan.\n\n## Steps\n1. %s: the change. Covers R1.\n\n## Tests\n- R1.S1: a test.\n' "$3" "$(basename "$1")" > "$1/specs/$2/plan.md"
  for next in plan build; do
    [ "$4" = spec ] && break
    st --home "$1" --spec "$2" approve --force "demo data" >/dev/null
    [ "$4" = "$next" ] && break
  done
  st --home "$1" --spec "$2" status "$5" >/dev/null
}
spec "$SYNC" sync-lists "Sync lists between Macs" build working
spec "$SYNC" sync-conflicts "Resolve sync conflicts" spec awaiting-approval
spec "$WEB" share-link "Share a list by link" plan awaiting-approval
spec "$WEB" list-pages "A page for each list" spec working

# Three areas, each with a color. The sidebar shows them in this order.
id() { uuidgen | tr 'A-Z' 'a-z'; }
cat > "$SUPPORT/areas.json" <<JSON
{
  "version": 1,
  "areas": [
    {"id": "$(id)", "name": "Notes app", "color": "blue", "repos": ["$NOTES"], "folded": false},
    {"id": "$(id)", "name": "Website", "color": "green", "repos": ["$WEB"], "folded": ${FOLD_WEB:-false}},
    {"id": "$(id)", "name": "Sync", "color": "orange", "repos": ["$SYNC"], "folded": false}
  ],
  "dismissed": [],
  "pinned": [],
  "offerDone": true
}
JSON

P="Shared lists"
st project new "$P" --description "Share a list with other people, and keep it the same on each Mac." --area "Notes app" --target 2027-02-15 >/dev/null
st project add "$P" sync-lists sync-conflicts --repo "$SYNC" --milestone Sync >/dev/null
st project add "$P" share-link --repo "$WEB" --milestone Sharing >/dev/null
st project add "$P" open-count --repo "$NOTES" --milestone Sharing >/dev/null
st project wait sync-conflicts --on sync-lists --repo "$SYNC" >/dev/null
st project status "$P" in-progress >/dev/null
st project update "$P" "Sync works between two Macs. Conflicts are next." --health on-track --by Demo >/dev/null
st project show "$P" --json | python3 -c 'import json,sys; print(json.load(sys.stdin)["id"])'
