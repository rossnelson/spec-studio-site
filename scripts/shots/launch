#!/bin/sh
# launch <theme> <support folder> [sessions|-] [-key value ...]: quits the earlier test copy (by its pid) and opens it
# again at 1280x800, on the demo spec, with the app and its terminals in the theme.
#
# The test copy shares its bundle ID, and so its settings store, with the installed app. The
# arguments below override settings for this run only, but the app still saves some of them back
# (the selected spec, the window frame). So the first launch saves those keys, and `./restore`
# puts them back when you are done.
S=$(cd "$(dirname "$0")" && pwd)
TRY="$HOME/Library/Caches/Spec Studio/try/marketing"
DOMAIN=dev.local.spec-studio
if [ ! -f "$S/defaults-backup.txt" ]; then
  # Each line: key, type and value, so restore writes the value with the type the app reads.
  for pair in selectedSpec:string "NSWindow Frame SpecStudioMain:string" sidebarPanel:int; do
    key=${pair%:*}; type=${pair##*:}
    printf '%s\t%s\t%s\n' "$key" "$type" "$(defaults read "$DOMAIN" "$key" 2>/dev/null)" >> "$S/defaults-backup.txt"
  done
fi
[ -f "$S/try.pid" ] && kill "$(cat "$S/try.pid")" 2>/dev/null && sleep 1.5
if [ "$3" = sessions ]; then NS=; else NS=1; fi
# Any arguments after the third override more settings for this run, for example -sidebarPanel 1.
THEME=$1 SUPPORT=$2; if [ $# -ge 3 ]; then shift 3; else set --; fi
# The terminals read the Ghostty config, not the app theme: give the test copy its own config
# folder, with its own Ghostty config and a link to every other folder of ~/.config, so gh and
# the other tools in its sessions stay signed in.
rm -rf "$S/xdg"; mkdir -p "$S/xdg/ghostty"
for entry in "${XDG_CONFIG_HOME:-$HOME/.config}"/*; do
  [ "$(basename "$entry")" = ghostty ] || ln -s "$entry" "$S/xdg/$(basename "$entry")"
done
printf 'theme = %s\n' "$THEME" > "$S/xdg/ghostty/config"
XDG_CONFIG_HOME="$S/xdg" SPEC_STUDIO_NO_SESSIONS=$NS SPEC_STUDIO_SUPPORT="$SUPPORT" nohup "$TRY/Spec Studio.app/Contents/MacOS/SpecStudio" \
  -appTheme "$THEME" -selectedSpec "/Users/Shared/spec-studio-demo/notes#open-count" \
  -"NSWindow Frame SpecStudioMain" "100 60 1280 800 0 0 1512 949" "$@" > "$TRY/app.log" 2>&1 &
echo $! > "$S/try.pid"; sleep 5
"$S/windows" "$(cat "$S/try.pid")"
