#!/bin/sh
# shoot-areas <theme> <suffix>: the two stills of areas and collections, from the
# demo data of ./demo-areas, into shots/: areas-sidebar and areas-folded, each
# with <suffix> ("" for light, "-dark" for dark). TRY names the test copy's folder.
# Example: ./shoot-areas "TokyoNight Day" "" && ./shoot-areas "TokyoNight Storm" -dark
set -e
S=$(cd "$(dirname "$0")" && pwd)
TRY="${TRY:-$HOME/Library/Caches/Spec Studio/try/marketing}"
SUPPORT="$TRY/support-areas"
fold() { python3 -c "
import json, sys
path, name = sys.argv[1], sys.argv[2]
data = json.load(open(path))
for area in data['areas']: area['folded'] = area['name'] == name
json.dump(data, open(path, 'w'), indent=2)" "$SUPPORT/areas.json" "$1"; sleep 2; }
# -collectionsFolded NO: the stills show the Collections section open, also when it is folded in your own app.
window() { "$S/launch" "$1" "$SUPPORT" - -sidebarPanel 0 -collectionsFolded NO "$2" "$3" | head -1 | cut -d' ' -f1; }
mkdir -p "$S/shots"
fold none
W=$(window "$1" -selectedSpec "/Users/Shared/spec-studio-demo/notes#open-count")
# The test copy starts no Claude session: hide the empty Claude pane (Hide Claude, ⌃⌘C).
"$S/press" c control command >/dev/null; sleep 1
"$S/cap" -x -o -l "$W" "$S/shots/areas-sidebar$2.png"
fold Website
"$S/cap" -x -o -l "$W" "$S/shots/areas-folded$2.png"
fold none
ls "$S/shots"
