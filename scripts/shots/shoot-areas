#!/bin/sh
# shoot-areas <theme> <suffix>: the three stills of areas and projects, from the
# demo data of ./demo-areas, into shots/: areas-sidebar, areas-folded and
# project-view, each with <suffix> ("" for light, "-dark" for dark).
# Example: ./shoot-areas "TokyoNight Day" "" && ./shoot-areas "TokyoNight Storm" -dark
set -e
S=$(cd "$(dirname "$0")" && pwd)
SUPPORT="$HOME/Library/Caches/Spec Studio/try/marketing/support-areas"
fold() { python3 -c "
import json, sys
path, name = sys.argv[1], sys.argv[2]
data = json.load(open(path))
for area in data['areas']: area['folded'] = area['name'] == name
json.dump(data, open(path, 'w'), indent=2)" "$SUPPORT/areas.json" "$1"; sleep 2; }
window() { "$S/launch" "$1" "$SUPPORT" - -sidebarPanel 0 "$2" "$3" | head -1 | cut -d' ' -f1; }
mkdir -p "$S/shots"
fold none
W=$(window "$1" -selectedSpec "/Users/Shared/spec-studio-demo/notes#open-count")
"$S/cap" -x -o -l "$W" "$S/shots/areas-sidebar$2.png"
fold Website
"$S/cap" -x -o -l "$W" "$S/shots/areas-folded$2.png"
fold none
ID=$(python3 -c "import json, sys; print(json.load(open(sys.argv[1]))['projects'][0]['id'])" "$SUPPORT/projects.json")
W=$(window "$1" -selectedSpec "project:$ID")
"$S/cap" -x -o -l "$W" "$S/shots/project-view$2.png"
ls "$S/shots"
